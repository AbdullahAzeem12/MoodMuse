<vector xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:aapt="http://schemas.android.com/aapt"
    android:width="100dp"
    android:height="100dp"
    android:viewportWidth="100"
    android:viewportHeight="100">

    <!-- Outer Circle with gradient -->
    <path
        android:pathData="M50,50m-48,0a48,48 0,1 1,96 0a48,48 0,1 1,-96 0">
        <aapt:attr name="android:fillColor">
            <gradient
                android:type="radial"
                android:centerX="50"
                android:centerY="50"
                android:gradientRadius="50">
                <item android:color="#FFD700" android:offset="0.0" />
                <item android:color="#FF8C00" android:offset="1.0" />
            </gradient>
        </aapt:attr>
    </path>

    <!-- Inner Wave -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeWidth="4"
        android:strokeLineCap="round"
        android:pathData="M20,50 Q35,30 50,50 T80,50" />

    <!-- Smaller wave -->
    <path
        android:strokeColor="@android:color/white"
        android:strokeAlpha="0.7"
        android:strokeWidth="3"
        android:strokeLineCap="round"
        android:pathData="M25,65 Q40,55 50,65 T75,65" />
</vector>
