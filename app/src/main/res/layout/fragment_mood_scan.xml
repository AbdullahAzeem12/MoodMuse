<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Decorative Physics Bubbles (Background Layer) -->
    <View android:id="@+id/decorCircle1" android:layout_width="85dp" android:layout_height="85dp" android:alpha="0.12" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" android:elevation="0dp" />
    <View android:id="@+id/decorCircle2" android:layout_width="95dp" android:layout_height="95dp" android:alpha="0.15" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle3" android:layout_width="75dp" android:layout_height="75dp" android:alpha="0.1" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" android:elevation="0dp" />
    <View android:id="@+id/decorCircle4" android:layout_width="110dp" android:layout_height="110dp" android:alpha="0.08" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle5" android:layout_width="65dp" android:layout_height="65dp" android:alpha="0.14" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" android:elevation="0dp" />
    <View android:id="@+id/decorCircle6" android:layout_width="100dp" android:layout_height="100dp" android:alpha="0.11" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle7" android:layout_width="80dp" android:layout_height="80dp" android:alpha="0.13" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" android:elevation="0dp" />
    <View android:id="@+id/decorCircle8" android:layout_width="80dp" android:layout_height="80dp" android:alpha="0.15" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle9" android:layout_width="110dp" android:layout_height="110dp" android:alpha="0.08" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle10" android:layout_width="65dp" android:layout_height="65dp" android:alpha="0.12" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />
    <View android:id="@+id/decorCircle11" android:layout_width="100dp" android:layout_height="100dp" android:alpha="0.09" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" android:elevation="0dp" />

    <!-- Main Content Layer -->
    <androidx.constraintlayout.widget.ConstraintLayout
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:padding="20dp"
        android:elevation="1dp">

        <!-- Header Section -->
        <TextView
            android:id="@+id/camera_header"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Mood Scanner"
            android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
            android:textColor="@android:color/white"
            android:textStyle="bold"
            android:layout_marginTop="24dp"
            android:shadowColor="@color/neon_blue"
            android:shadowDx="0"
            android:shadowDy="0"
            android:shadowRadius="15"
            app:layout_constraintTop_toTopOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <TextView
            android:id="@+id/camera_subtitle"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Reveal your inner harmony"
            android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
            android:textColor="@android:color/white"
            android:alpha="0.8"
            android:layout_marginTop="4dp"
            app:layout_constraintTop_toBottomOf="@+id/camera_header"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Camera Preview with Floating Glass Frame -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/camera_card"
            android:layout_width="0dp"
            android:layout_height="0dp"
            android:layout_marginHorizontal="16dp"
            android:layout_marginTop="30dp"
            app:cardCornerRadius="40dp"
            app:cardElevation="12dp"
            android:backgroundTint="@android:color/transparent"
            app:strokeWidth="2.5dp"
            app:strokeColor="#70FFFFFF"
            app:layout_constraintDimensionRatio="1:1.2"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toBottomOf="@+id/camera_subtitle">

            <FrameLayout
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:background="@drawable/glass_card">

                <androidx.camera.view.PreviewView
                    android:id="@+id/preview_view"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent" />

                <!-- Face Guide Overlay (Aesthetic focus) -->
                <View
                    android:id="@+id/face_guide"
                    android:layout_width="240dp"
                    android:layout_height="280dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@android:color/transparent"
                    app:strokeWidth="2dp"
                    app:strokeColor="@android:color/white"
                    android:scaleY="1.2" />

                <!-- Scanning Overlay (Glowing line) -->
                <View
                    android:id="@+id/scan_line"
                    android:layout_width="match_parent"
                    android:layout_height="4dp"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/neon_blue"
                    android:alpha="0.6"
                    android:elevation="4dp" />

            </FrameLayout>
        </com.google.android.material.card.MaterialCardView>

        <!-- Instructions (Subtle glass) -->
        <com.google.android.material.card.MaterialCardView
            android:id="@+id/instruction_card"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="9dp"
            app:cardCornerRadius="20dp"
            android:backgroundTint="#20FFFFFF"
            app:strokeWidth="1dp"
            app:strokeColor="#30FFFFFF"
            app:layout_constraintTop_toBottomOf="@+id/camera_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <TextView
                android:id="@+id/tv_instruction"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:paddingHorizontal="20dp"
                android:paddingVertical="8dp"
                android:text="Position face for AI Calibration"
                android:textAppearance="@style/TextAppearance.Material3.LabelLarge"
                android:textColor="@android:color/white" />
        </com.google.android.material.card.MaterialCardView>

        <!-- AI Confidence Meter -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/confidence_meter"
            android:layout_width="200dp"
            android:layout_height="wrap_content"
            android:layout_marginTop="6dp"
            app:indicatorColor="@color/neon_blue"
            app:trackColor="#30FFFFFF"
            app:trackCornerRadius="4dp"
            android:progress="0"
            app:layout_constraintTop_toBottomOf="@+id/instruction_card"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- Smooth Capture Button Section: Repositioned below Confidence Meter -->
        <FrameLayout
            android:id="@+id/capture_button_container"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:layout_marginTop="8dp"
            app:layout_constraintTop_toBottomOf="@+id/confidence_meter"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <!-- Outer Pulse Glow -->
            <View
                android:id="@+id/btn_pulse_ring"
                android:layout_width="96dp"
                android:layout_height="98dp"
                android:layout_gravity="center"
                android:alpha="0.2"
                android:background="@drawable/bg_circle"
                android:backgroundTint="@color/neon_blue" />

            <!-- Main Interactive Button -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/btn_capture"
                android:layout_width="80dp"
                android:layout_height="80dp"
                android:layout_gravity="center"
                app:cardCornerRadius="40dp"
                app:cardElevation="16dp"
                android:backgroundTint="#F5FFFFFF"
                android:clickable="true"
                android:focusable="true"
                app:rippleColor="#4000D4FF"
                app:strokeWidth="3dp"
                app:strokeColor="@color/neon_blue">

                <ImageView
                    android:id="@+id/capture_icon"
                    android:layout_width="48dp"
                    android:layout_height="48dp"
                    android:layout_gravity="center"
                    android:src="@drawable/ic_mood_scan"
                    app:tint="@color/brand_gradient_start" />

            </com.google.android.material.card.MaterialCardView>

        </FrameLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</FrameLayout>
