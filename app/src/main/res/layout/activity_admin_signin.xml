<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_gradient_brand">

    <ImageView
        android:id="@+id/backButton"
        android:layout_width="40dp"
        android:layout_height="40dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/auth_surface"
        android:padding="4dp"
        android:layout_margin="6dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        android:contentDescription="Back" />


    <TextView
        android:id="@+id/adminTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Admin Portal"
        android:textSize="36sp"
        android:textColor="@color/neon_purple"
        android:textStyle="bold"
        android:fontFamily="@font/poppins"
        android:gravity="center"
        android:shadowColor="@color/text_primary_light"
        android:shadowDx="0"
        android:shadowDy="6"
        android:shadowRadius="16"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/adminSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Secure access to management dashboard"
        android:textSize="16sp"
        android:textColor="@color/semi_transparent_white"
        android:fontFamily="@font/montserrat"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/adminTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <com.google.android.material.card.MaterialCardView
        android:id="@+id/loginCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="20dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/transparent"
        app:strokeColor="@color/material_purple"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toBottomOf="@id/adminSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <TextView
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginBottom="16dp"
                android:fontFamily="@font/poppins"
                android:text="Sign In"
                android:textColor="@color/auth_surface"
                android:textSize="20sp"
                android:textStyle="bold" />

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/adminIdLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Admin ID"
                app:startIconDrawable="@android:drawable/ic_menu_my_calendar"
                app:startIconTint="@color/admin_accent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/adminIdInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="text" />
            </com.google.android.material.textfield.TextInputLayout>

            <com.google.android.material.textfield.TextInputLayout
                android:id="@+id/passwordLayout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:hint="Password"
                android:layout_marginTop="16dp"
                app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                app:startIconTint="@color/admin_accent"
                app:endIconMode="password_toggle"
                app:endIconTint="@color/admin_accent"
                style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                <com.google.android.material.textfield.TextInputEditText
                    android:id="@+id/passwordInput"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:inputType="textPassword" />
            </com.google.android.material.textfield.TextInputLayout>

            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="16dp">

                <CheckBox
                    android:id="@+id/rememberMeCheckbox"
                    android:layout_width="0dp"
                    android:layout_height="wrap_content"
                    android:layout_weight="1"
                    android:text="Remember me"
                    android:textSize="14sp"
                    android:buttonTint="@color/admin_accent"
                    android:layout_marginEnd="16dp" />

                <TextView
                    android:id="@+id/forgotPasswordLink"
                    android:layout_width="wrap_content"
                    android:layout_height="wrap_content"
                    android:text="Forgot Password?"
                    android:textColor="@color/admin_accent"
                    android:textSize="14sp" />
            </LinearLayout>

            <com.google.android.material.button.MaterialButton
                android:id="@+id/signInButton"
                android:layout_width="match_parent"
                android:layout_height="56dp"
                android:text="Sign In"
                android:textColor="@android:color/white"
                android:textAllCaps="false"
                android:textSize="16sp"
                app:cornerRadius="16dp"
                android:layout_marginTop="24dp"
                android:backgroundTint="@color/material_blue"
                app:icon="@android:drawable/ic_secure"
                app:iconGravity="end"
                app:iconTint="@color/admin_accent" />

            <TextView
                android:id="@+id/securityNotice"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="This portal is for authorized personnel only. All login attempts are logged and monitored."
                android:textSize="12sp"
                android:textColor="@color/admin_warning"
                android:gravity="center"
                android:layout_marginTop="16dp" />
        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <LinearLayout
        android:id="@+id/twoFactorSection"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:orientation="vertical"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="8dp"
        app:layout_constraintTop_toBottomOf="@id/loginCard"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="Two-Factor Authentication"
            android:textSize="16sp"
            android:textColor="@color/auth_surface"
            android:textStyle="bold"
            android:gravity="center" />

        <TextView
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:text="For enhanced security, this account requires two-factor authentication"
            android:textSize="14sp"
            android:textColor="@color/auth_surface"
            android:gravity="center"
            android:layout_marginTop="3dp" />
    </LinearLayout>

    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="16dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Need an admin account? "
            android:textColor="@color/auth_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/registerLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Register"
            android:textColor="@color/neon_blue"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>

    <!-- Decorative Elements - Same as RoleSelectionActivity -->
    <View
        android:id="@+id/decorCircle1"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:alpha="0.12"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle2"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle3"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:alpha="0.1"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle4"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle5"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:alpha="0.14"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle6"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.11"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle7"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.13"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle8"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle9"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle10"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:alpha="0.12"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle11"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.09"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>