<?xml version="1.0" encoding="utf-8"?>
<androidx.constraintlayout.widget.ConstraintLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    xmlns:tools="http://schemas.android.com/tools"
    android:id="@+id/registerRoot"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/bg_signin_gradient_warm"
    tools:context="com.example.moodmuse.ui.auth.UserRegisterActivity">

    <!-- Close / Back -->
    <ImageView
        android:id="@+id/backButton"
        android:layout_width="48dp"
        android:layout_height="48dp"
        android:src="@android:drawable/ic_menu_close_clear_cancel"
        android:tint="@color/auth_surface"
        android:padding="12dp"
        android:layout_margin="16dp"
        android:contentDescription="@string/cd_close"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent" />

    <ImageView
        android:id="@+id/logoImage"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:src="@drawable/ic_moodmuse_logo_v2"
        android:layout_marginTop="48dp"
        app:layout_constraintTop_toTopOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent"
        android:contentDescription="MoodMuse Logo" />

    <!-- Title -->
    <TextView
        android:id="@+id/registerTitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Create Account"
        android:textSize="28sp"
        android:textColor="@color/neon_orange"
        android:textStyle="bold"
        android:gravity="center"
        android:shadowColor="@android:color/white"
        android:shadowDx="0"
        android:shadowDy="0"
        android:shadowRadius="16"
        android:layout_marginTop="16dp"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        app:layout_constraintTop_toBottomOf="@+id/logoImage"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <TextView
        android:id="@+id/registerSubtitle"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:text="Start tracking your moods and emotions"
        android:textSize="16sp"
        android:textColor="@color/auth_surface"
        android:gravity="center"
        android:layout_marginTop="8dp"
        android:layout_marginStart="32dp"
        android:layout_marginEnd="32dp"
        app:layout_constraintTop_toBottomOf="@id/registerTitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent" />

    <!-- Card container for the steps -->
    <com.google.android.material.card.MaterialCardView
        android:id="@+id/registerStepCard"
        android:layout_width="0dp"
        android:layout_height="wrap_content"
        android:layout_marginStart="24dp"
        android:layout_marginEnd="24dp"
        android:layout_marginTop="24dp"
        app:cardCornerRadius="24dp"
        app:cardElevation="12dp"
        app:cardBackgroundColor="@color/transparent"
        app:strokeColor="#FFD700"
        app:strokeWidth="3dp"
        app:layout_constraintTop_toBottomOf="@id/registerSubtitle"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <LinearLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:padding="24dp">

            <!-- Step indicators -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:gravity="center"
                android:layout_marginBottom="16dp">

                <View
                    android:id="@+id/step1Indicator"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="#FFC107"
                    android:layout_marginEnd="6dp" />

                <View
                    android:id="@+id/step2Indicator"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@color/auth_divider"
                    android:layout_marginStart="3dp"
                    android:layout_marginEnd="3dp" />

                <View
                    android:id="@+id/step3Indicator"
                    android:layout_width="0dp"
                    android:layout_height="6dp"
                    android:layout_weight="1"
                    android:background="@color/auth_divider"
                    android:layout_marginStart="6dp" />
            </LinearLayout>

            <!-- Step title -->
            <TextView
                android:id="@+id/stepTitle"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Personal Information"
                android:textSize="18sp"
                android:textStyle="bold"
                android:textColor="@color/auth_text_primary"
                android:layout_marginBottom="16dp" />

            <!-- Step 1: Personal Information -->
            <LinearLayout
                android:id="@+id/step1Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/nameLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Full Name"
                    app:startIconDrawable="@android:drawable/ic_menu_myplaces"
                    app:startIconTint="@color/auth_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/nameInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPersonName"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:contentDescription="@string/cd_full_name" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/emailLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Email"
                    android:layout_marginTop="16dp"
                    app:startIconDrawable="@android:drawable/ic_dialog_email"
                    app:startIconTint="@color/auth_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/emailInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textEmailAddress"
                        android:imeOptions="actionNext"
                        android:importantForAutofill="yes"
                        android:contentDescription="@string/cd_email" />
                </com.google.android.material.textfield.TextInputLayout>
            </LinearLayout>

            <!-- Step 2: Password (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/step2Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/passwordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Password"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/auth_surface"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/auth_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/passwordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionNext"
                        android:contentDescription="@string/cd_password" />
                </com.google.android.material.textfield.TextInputLayout>

                <com.google.android.material.textfield.TextInputLayout
                    android:id="@+id/confirmPasswordLayout"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:hint="Confirm Password"
                    android:layout_marginTop="16dp"
                    app:startIconDrawable="@android:drawable/ic_lock_idle_lock"
                    app:startIconTint="@color/auth_surface"
                    app:endIconMode="password_toggle"
                    app:endIconTint="@color/auth_surface"
                    style="@style/Widget.MaterialComponents.TextInputLayout.OutlinedBox">

                    <com.google.android.material.textfield.TextInputEditText
                        android:id="@+id/confirmPasswordInput"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:inputType="textPassword"
                        android:imeOptions="actionDone"
                        android:contentDescription="@string/cd_confirm_password" />
                </com.google.android.material.textfield.TextInputLayout>

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:orientation="horizontal"
                    android:layout_marginTop="16dp">

                    <ImageView
                        android:id="@+id/passwordStrengthIcon"
                        android:layout_width="24dp"
                        android:layout_height="24dp"
                        android:src="@android:drawable/ic_partial_secure"
                        android:tint="@color/auth_surface"
                        android:contentDescription="@string/cd_password_strength_icon" />

                    <TextView
                        android:id="@+id/passwordStrengthText"
                        android:layout_width="wrap_content"
                        android:layout_height="wrap_content"
                        android:text="Password Strength: Medium"
                        android:textSize="14sp"
                        android:textColor="#FFC107"
                        android:layout_marginStart="8dp" />
                </LinearLayout>
            </LinearLayout>

            <!-- Step 3: Preferences (Initially Hidden) -->
            <LinearLayout
                android:id="@+id/step3Layout"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="vertical"
                android:visibility="gone">

                <TextView
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="What are your primary interests?"
                    android:textSize="16sp"
                    android:textColor="@color/auth_surface" />

                <CheckBox
                    android:id="@+id/moodTrackingCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Mood Tracking"
                    android:layout_marginTop="8dp"
                    android:buttonTint="@color/neon_orange" />

                <CheckBox
                    android:id="@+id/journalingCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Journaling"
                    android:buttonTint="@color/neon_orange" />

                <CheckBox
                    android:id="@+id/meditationCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Meditation"
                    android:buttonTint="@color/neon_orange" />

                <CheckBox
                    android:id="@+id/sleepTrackingCheckbox"
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:text="Sleep Tracking"
                    android:buttonTint="@color/neon_orange" />
            </LinearLayout>

            <!-- Navigation buttons -->
            <LinearLayout
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:orientation="horizontal"
                android:layout_marginTop="24dp">

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/backStepButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Back"
                    android:textColor="@color/auth_surface"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"

                    android:layout_marginEnd="8dp"
                    style="@style/Widget.MaterialComponents.Button.OutlinedButton"
                    android:visibility="gone" />

                <com.google.android.material.button.MaterialButton
                    android:id="@+id/nextStepButton"
                    android:layout_width="0dp"
                    android:layout_height="56dp"
                    android:layout_weight="1"
                    android:text="Next"
                    android:singleLine="true"
                    android:textAllCaps="false"
                    android:textSize="16sp"
                    app:cornerRadius="16dp"
                    app:iconGravity="textStart"
                    app:iconPadding="8dp"
                    android:backgroundTint="#FFC107" />
            </LinearLayout>

        </LinearLayout>
    </com.google.android.material.card.MaterialCardView>

    <!-- Bottom "Already have account?" -->
    <LinearLayout
        android:layout_width="wrap_content"
        android:layout_height="wrap_content"
        android:orientation="horizontal"
        android:layout_marginBottom="24dp"
        app:layout_constraintBottom_toBottomOf="parent"
        app:layout_constraintStart_toStartOf="parent"
        app:layout_constraintEnd_toEndOf="parent">

        <TextView
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Already have an account? "
            android:textColor="@color/auth_surface"
            android:textSize="14sp" />

        <TextView
            android:id="@+id/signInLink"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:text="Sign In"
            android:textColor="@color/neon_blue"
            android:textStyle="bold"
            android:textSize="14sp" />
    </LinearLayout>
    
    <View
        android:id="@+id/decorCircle1"
        android:layout_width="85dp"
        android:layout_height="85dp"
        android:alpha="0.12"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle2"
        android:layout_width="95dp"
        android:layout_height="95dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle3"
        android:layout_width="75dp"
        android:layout_height="75dp"
        android:alpha="0.1"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle4"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle5"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:alpha="0.14"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints"/>

    <View
        android:id="@+id/decorCircle6"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.11"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle7"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.13"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/semi_transparent_white"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle8"
        android:layout_width="80dp"
        android:layout_height="80dp"
        android:alpha="0.15"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle9"
        android:layout_width="110dp"
        android:layout_height="110dp"
        android:alpha="0.08"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle10"
        android:layout_width="65dp"
        android:layout_height="65dp"
        android:alpha="0.12"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

    <View
        android:id="@+id/decorCircle11"
        android:layout_width="100dp"
        android:layout_height="100dp"
        android:alpha="0.09"
        android:background="@drawable/bg_circle"
        android:backgroundTint="@color/text_primary_light"
        android:visibility="visible"
        tools:ignore="MissingConstraints" />

</androidx.constraintlayout.widget.ConstraintLayout>
