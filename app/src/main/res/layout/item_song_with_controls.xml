<?xml version="1.0" encoding="utf-8"?>
<com.google.android.material.card.MaterialCardView xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="wrap_content"
    android:layout_marginHorizontal="6dp"
    android:layout_marginVertical="8dp"
    app:cardCornerRadius="16dp"
    app:cardElevation="4dp"
    android:backgroundTint="#20FFFFFF"
    app:strokeWidth="1dp"
    app:strokeColor="#40FFFFFF"
    android:clickable="true"
    android:focusable="true"
    android:foreground="?attr/selectableItemBackground">

    <androidx.constraintlayout.widget.ConstraintLayout
        android:id="@+id/song_card_content"
        android:layout_width="match_parent"
        android:layout_height="wrap_content"
        android:paddingHorizontal="16dp"
        android:paddingVertical="14dp">

        <!-- Album Art -->
        <com.google.android.material.imageview.ShapeableImageView
            android:id="@+id/song_album_art"
            android:layout_width="72dp"
            android:layout_height="72dp"
            android:scaleType="centerCrop"
            app:shapeAppearanceOverlay="@style/ShapeAppearance.Material3.Corner.Medium"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintTop_toTopOf="parent" />

        <!-- Song Info -->
        <LinearLayout
            android:id="@+id/song_info_layout"
            android:layout_width="0dp"
            android:layout_height="wrap_content"
            android:orientation="vertical"
            android:layout_marginStart="16dp"
            android:layout_marginEnd="8dp"
            app:layout_constraintStart_toEndOf="@id/song_album_art"
            app:layout_constraintEnd_toStartOf="@id/song_overflow_button"
            app:layout_constraintTop_toTopOf="@id/song_album_art">

            <TextView
                android:id="@+id/song_title"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Song Title"
                android:textAppearance="@style/TextAppearance.Material3.TitleMedium"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true" />

            <TextView
                android:id="@+id/song_artist"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:text="Artist Name"
                android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                android:textColor="@android:color/white"
                android:alpha="0.8"
                android:maxLines="1"
                android:ellipsize="marquee"
                android:marqueeRepeatLimit="marquee_forever"
                android:singleLine="true"
                android:layout_marginTop="2dp" />

            <TextView
                android:id="@+id/song_album"
                android:layout_width="match_parent"
                android:layout_height="wrap_content"
                android:layout_marginTop="2dp"
                android:text="Album"
                android:textAppearance="@style/TextAppearance.Material3.LabelSmall"
                android:textColor="#B3FFFFFF"
                android:maxLines="1"
                android:ellipsize="end" />

        </LinearLayout>

        <!-- Options Icon - Top Right, Outside and Above Thumbnail -->
        <ImageButton
            android:id="@+id/song_overflow_button"
            android:layout_width="32dp"
            android:layout_height="32dp"
            android:background="?attr/selectableItemBackgroundBorderless"
            android:padding="4dp"
            android:src="@android:drawable/ic_menu_more"
            app:layout_constraintEnd_toEndOf="parent"
            app:layout_constraintTop_toTopOf="parent"
            app:tint="@android:color/white" />

        <!-- Compact Grid Controls (Visible only in Grid View) -->
        <LinearLayout
            android:id="@+id/grid_controls_layout"
            android:layout_width="wrap_content"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/song_album_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/grid_rewind_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_previous"
                app:tint="@android:color/white" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/grid_play_pause_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginHorizontal="6dp"
                app:fabCustomSize="32dp"
                app:icon="@drawable/ic_play"
                app:iconSize="16dp"
                app:iconTint="@android:color/white"
                app:backgroundTint="@color/neon_blue"
                app:borderWidth="0dp"
                app:elevation="2dp" />

            <ImageButton
                android:id="@+id/grid_forward_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/grid_like_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/grid_add_playlist_button"
                android:layout_width="28dp"
                android:layout_height="28dp"
                android:padding="4dp"
                android:scaleType="fitCenter"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@android:color/white" />

        </LinearLayout>

        <!-- Playback Indicator -->
        <com.google.android.material.progressindicator.LinearProgressIndicator
            android:id="@+id/playing_indicator"
            android:layout_width="0dp"
            android:layout_height="3dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:trackColor="#15FFFFFF"
            app:indicatorColor="@color/neon_blue"
            app:layout_constraintTop_toBottomOf="@id/song_album_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent"
            android:indeterminate="true" />

        <com.airbnb.lottie.LottieAnimationView
            android:id="@+id/song_wave_animation"
            android:layout_width="40dp"
            android:layout_height="20dp"
            android:visibility="gone"
            app:layout_constraintBottom_toBottomOf="@id/song_album_art"
            app:layout_constraintEnd_toEndOf="parent" />

        <!-- YouTube Player Container -->
        <FrameLayout
            android:id="@+id/youtube_player_container"
            android:layout_width="match_parent"
            android:layout_height="200dp"
            android:layout_marginTop="12dp"
            android:visibility="gone"
            app:layout_constraintTop_toBottomOf="@id/song_album_art"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageView
                android:id="@+id/youtube_thumbnail"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:adjustViewBounds="true"
                android:scaleType="centerCrop"
                android:background="@drawable/bg_circle"
                android:backgroundTint="#30FFFFFF" />

            <androidx.media3.ui.PlayerView
                android:id="@+id/itunes_player_view"
                android:layout_width="match_parent"
                android:layout_height="match_parent"
                android:visibility="gone"
                app:use_controller="false" />
        </FrameLayout>

        <!-- Playback Controls -->
        <LinearLayout
            android:id="@+id/controls_layout"
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:orientation="horizontal"
            android:gravity="center_vertical"
            android:layout_marginTop="12dp"
            app:layout_constraintTop_toBottomOf="@id/youtube_player_container"
            app:layout_constraintStart_toStartOf="parent"
            app:layout_constraintEnd_toEndOf="parent">

            <ImageButton
                android:id="@+id/rewind_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_previous"
                app:tint="@android:color/white" />

            <View android:layout_width="12dp" android:layout_height="0dp" />

            <com.google.android.material.floatingactionbutton.FloatingActionButton
                android:id="@+id/play_pause_button"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                app:fabCustomSize="44dp"
                app:icon="@drawable/ic_play"
                app:iconTint="@android:color/white"
                app:backgroundTint="@color/neon_blue"
                app:borderWidth="0dp"
                app:elevation="4dp" />

            <View android:layout_width="12dp" android:layout_height="0dp" />

            <ImageButton
                android:id="@+id/forward_button"
                android:layout_width="36dp"
                android:layout_height="36dp"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_skip_next"
                app:tint="@android:color/white" />

            <View android:layout_width="8dp" android:layout_height="0dp" />

            <ImageButton
                android:id="@+id/song_like_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/like"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_heart"
                app:tint="@android:color/white" />

            <ImageButton
                android:id="@+id/song_add_playlist_button"
                android:layout_width="40dp"
                android:layout_height="40dp"
                android:contentDescription="@string/add_to_playlist"
                android:background="?attr/selectableItemBackgroundBorderless"
                android:src="@drawable/ic_add"
                app:tint="@android:color/white" />

            <View android:layout_width="0dp" android:layout_height="0dp" android:layout_weight="1" />

            <TextView
                android:id="@+id/song_duration"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginEnd="8dp"
                android:text="0:30"
                android:textAppearance="@style/TextAppearance.Material3.LabelMedium"
                android:textColor="#B3FFFFFF" />

        </LinearLayout>

    </androidx.constraintlayout.widget.ConstraintLayout>

</com.google.android.material.card.MaterialCardView>
