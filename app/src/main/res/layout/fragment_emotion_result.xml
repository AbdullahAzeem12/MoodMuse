<?xml version="1.0" encoding="utf-8"?>
<FrameLayout xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:app="http://schemas.android.com/apk/res-auto"
    android:layout_width="match_parent"
    android:layout_height="match_parent"
    android:background="@drawable/gradient_background">

    <!-- Aesthetic Background Layer -->
    <FrameLayout
        android:id="@+id/background_container"
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:elevation="0dp">

        <View android:id="@+id/decorCircle1" android:layout_width="140dp" android:layout_height="140dp" android:alpha="0.12" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" />
        <View android:id="@+id/decorCircle2" android:layout_width="90dp" android:layout_height="90dp" android:alpha="0.15" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle3" android:layout_width="100dp" android:layout_height="100dp" android:alpha="0.10" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" />
        <View android:id="@+id/decorCircle4" android:layout_width="65dp" android:layout_height="65dp" android:alpha="0.08" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle5" android:layout_width="120dp" android:layout_height="120dp" android:alpha="0.14" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" />
        <View android:id="@+id/decorCircle6" android:layout_width="160dp" android:layout_height="160dp" android:alpha="0.11" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle7" android:layout_width="130dp" android:layout_height="130dp" android:alpha="0.13" android:background="@drawable/bg_circle" android:backgroundTint="@color/semi_transparent_white" />
        <View android:id="@+id/decorCircle8" android:layout_width="110dp" android:layout_height="110dp" android:alpha="0.15" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle9" android:layout_width="70dp" android:layout_height="70dp" android:alpha="0.08" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle10" android:layout_width="80dp" android:layout_height="80dp" android:alpha="0.12" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />
        <View android:id="@+id/decorCircle11" android:layout_width="150dp" android:layout_height="150dp" android:alpha="0.09" android:background="@drawable/bg_circle" android:backgroundTint="@color/text_primary_light" />

    </FrameLayout>

    <ScrollView
        android:layout_width="match_parent"
        android:layout_height="match_parent"
        android:fillViewport="true"
        android:elevation="1dp">

        <androidx.constraintlayout.widget.ConstraintLayout
            android:layout_width="match_parent"
            android:layout_height="wrap_content"
            android:padding="24dp">

            <!-- Result Header -->
            <TextView
                android:id="@+id/result_header"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Mood Analysis"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineMedium"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginTop="16dp"
                android:shadowColor="#80000000"
                android:shadowRadius="8"
                app:layout_constraintTop_toTopOf="parent"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Emoji Card with Neon Glow -->
            <FrameLayout
                android:id="@+id/emoji_container"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                app:layout_constraintTop_toBottomOf="@+id/result_header"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Outer Glow Ring -->
                <View
                    android:id="@+id/emoji_glow_ring"
                    android:layout_width="180dp"
                    android:layout_height="180dp"
                    android:layout_gravity="center"
                    android:alpha="0.3"
                    android:background="@drawable/bg_circle"
                    android:backgroundTint="@color/neon_blue" />

                <com.google.android.material.card.MaterialCardView
                    android:id="@+id/emotion_emoji_card"
                    android:layout_width="160dp"
                    android:layout_height="160dp"
                    android:layout_gravity="center"
                    app:cardCornerRadius="80dp"
                    app:cardElevation="20dp"
                    android:backgroundTint="#F5FFFFFF"
                    app:strokeWidth="4dp"
                    app:strokeColor="@color/neon_blue">

                    <TextView
                        android:id="@+id/emotion_emoji"
                        android:layout_width="match_parent"
                        android:layout_height="match_parent"
                        android:text="😊"
                        android:textSize="90sp"
                        android:gravity="center" />

                </com.google.android.material.card.MaterialCardView>
            </FrameLayout>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/scan_image_card"
                android:layout_width="0dp"
                android:layout_height="240dp"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="24dp"
                app:cardElevation="10dp"
                android:backgroundTint="#20FFFFFF"
                app:strokeWidth="1.5dp"
                app:strokeColor="#50FFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/emoji_container"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <com.google.android.material.imageview.ShapeableImageView
                    android:id="@+id/scan_image"
                    android:layout_width="match_parent"
                    android:layout_height="match_parent"
                    android:scaleType="centerCrop"
                    android:contentDescription="@string/app_name" />

            </com.google.android.material.card.MaterialCardView>

            <!-- Detected Emotion Title -->
            <TextView
                android:id="@+id/emotion_title"
                android:layout_width="wrap_content"
                android:layout_height="wrap_content"
                android:text="Radiant Joy"
                android:textAppearance="@style/TextAppearance.Material3.HeadlineLarge"
                android:textColor="@android:color/white"
                android:textStyle="bold"
                android:layout_marginTop="32dp"
                android:shadowColor="@color/neon_blue"
                android:shadowRadius="15"
                app:layout_constraintTop_toBottomOf="@+id/scan_image_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent" />

            <!-- Insight Card (Glassmorphism) -->
            <com.google.android.material.card.MaterialCardView
                android:id="@+id/insight_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="24dp"
                app:cardCornerRadius="28dp"
                android:backgroundTint="@android:color/transparent"
                app:strokeWidth="1.5dp"
                app:strokeColor="#50FFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/emotion_title"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card"
                    android:orientation="vertical"
                    android:padding="24dp">

                    <TextView
                        android:id="@+id/emotion_description"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:text="Your energy is high and positive! This is the perfect time to explore upbeat rhythms."
                        android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                        android:textColor="@android:color/white"
                        android:gravity="center"
                        android:lineSpacingExtra="6dp"
                        android:alpha="0.95" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <com.google.android.material.card.MaterialCardView
                android:id="@+id/debug_card"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="16dp"
                app:cardCornerRadius="22dp"
                android:backgroundTint="@android:color/transparent"
                app:strokeWidth="1.5dp"
                app:strokeColor="#40FFFFFF"
                app:layout_constraintTop_toBottomOf="@+id/insight_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <LinearLayout
                    android:layout_width="match_parent"
                    android:layout_height="wrap_content"
                    android:background="@drawable/glass_card"
                    android:orientation="vertical"
                    android:padding="18dp">

                    <TextView
                        android:id="@+id/debug_details"
                        android:layout_width="match_parent"
                        android:layout_height="wrap_content"
                        android:textAppearance="@style/TextAppearance.Material3.BodyMedium"
                        android:textColor="@android:color/white"
                        android:alpha="0.85"
                        android:text="Debug: -" />

                </LinearLayout>
            </com.google.android.material.card.MaterialCardView>

            <!-- Action Buttons Section -->
            <LinearLayout
                android:id="@+id/actions_container"
                android:layout_width="0dp"
                android:layout_height="wrap_content"
                android:layout_marginTop="40dp"
                android:orientation="vertical"
                app:layout_constraintTop_toBottomOf="@+id/debug_card"
                app:layout_constraintStart_toStartOf="parent"
                app:layout_constraintEnd_toEndOf="parent">

                <!-- Primary Action: Discover Music -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_discover_music"
                    android:layout_width="match_parent"
                    android:layout_height="72dp"
                    android:text="Sync Music Harmony"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Material3.TitleLarge"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_music_discover"
                    app:iconSize="32dp"
                    app:iconPadding="16dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="36dp"
                    android:backgroundTint="@android:color/white"
                    android:textColor="@color/brand_gradient_start"
                    app:iconTint="@color/brand_gradient_start"
                    app:rippleColor="#405B86E5"
                    android:elevation="12dp"
                    android:stateListAnimator="@null" />

                <!-- Secondary Action: Try Again -->
                <com.google.android.material.button.MaterialButton
                    android:id="@+id/btn_try_again"
                    android:layout_width="match_parent"
                    android:layout_height="64dp"
                    android:layout_marginTop="16dp"
                    android:text="Re-Scan Soul"
                    android:textAllCaps="false"
                    android:textAppearance="@style/TextAppearance.Material3.BodyLarge"
                    android:textStyle="bold"
                    app:icon="@drawable/ic_refresh_smooth"
                    app:iconSize="24dp"
                    app:iconPadding="12dp"
                    app:iconGravity="textStart"
                    app:cornerRadius="32dp"
                    android:backgroundTint="@android:color/transparent"
                    android:textColor="@android:color/white"
                    app:strokeColor="#A0FFFFFF"
                    app:strokeWidth="2dp"
                    app:rippleColor="#40FFFFFF"
                    android:elevation="4dp"
                    android:stateListAnimator="@null"
                    style="@style/Widget.Material3.Button.OutlinedButton" />

            </LinearLayout>

            <!-- Bottom Margin Spacer -->
            <View
                android:layout_width="match_parent"
                android:layout_height="40dp"
                app:layout_constraintTop_toBottomOf="@+id/actions_container" />

        </androidx.constraintlayout.widget.ConstraintLayout>
    </ScrollView>
</FrameLayout>
